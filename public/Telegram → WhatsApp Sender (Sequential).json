      "parameters": {
        "jsCode": "// =============================================\n// الإصلاح الرئيسي:\n// نجمع النص مع كل الأرقام قبل الـ Loop\n// items[0] = { text } من Code in JavaScript2\n// items[1..n] = { number, ... } من Google Sheets\n// =============================================\n\nconst textItem = items.find(i => i.json.text !== undefined && String(i.json.text).trim() !== '');\nconst numberItems = items.filter(i => i.json.number !== undefined);\n\nif (!textItem) return [];\n\nconst text = String(textItem.json.text).trim();\n\n// نُنشئ عنصر لكل رقم يحتوي على النص\nreturn numberItems.map(item => ({\n  json: {\n    text: text,\n    number: String(item.json.number).trim()\n  }\n}));"
      },
