      "parameters": {
        "jsCode": "const data = $input.all().map(i => i.json);\nconst numbers = data.filter(item => item.number !== undefined);\nconst images = data.filter(item => item.link);\nconst combinations = [];\n\nfor (const num of numbers) {\n  for (const img of images) {\n    combinations.push({\n      json: {\n        phone: String(num.number),\n        image_url: img.link\n      }\n    });\n  }\n}\n\nreturn combinations;"
